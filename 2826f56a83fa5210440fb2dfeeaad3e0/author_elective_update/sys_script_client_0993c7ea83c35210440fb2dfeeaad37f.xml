    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Don't show "edit" or "new" buttons in related lists whem media state is complete</description>
        <field>state</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Ocult related list buttons</name>
        <order/>
        <script><![CDATA[function onLoad(control, oldValue, newValue, isLoading, isTemplate) {
   
	if (g_form.getValue('state') == '3') {
	
		var relatedListActors = 'Actor';
		var rla = g_form.getControl(relatedListActors);
		if (rla) {
			rla.hideNewButton = true;
			rla.hideEditButton = true;
			rla.refresh();
		}
	}


}

]]></script>
